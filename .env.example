# Public origin this instance is served from.
# Production target is a subdomain of thedarwin.co.
NEXT_PUBLIC_SITE_URL=https://motion.thedarwin.co

# Guidelines Builder — reading references with a vision model.
# Server-side only; never exposed to the browser. Without it, references are
# traced locally (layout only, placeholder text) and the builder says so.
OPENAI_API_KEY=
# Any vision-capable chat model on your account. Defaults to gpt-4o.
OPENAI_MODEL=gpt-4o
